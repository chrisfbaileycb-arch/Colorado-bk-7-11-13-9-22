{
  "mcpServers": {
    "github-mcp-server": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ]
    },
    "AppDeploy": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://api-v2.appdeploy.ai/mcp"
      ]
    }
  }
}
